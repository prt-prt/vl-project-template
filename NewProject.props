<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MsBuildThisFileDirectory)Version.props" />
  <PropertyGroup>
    <VLAssetBehavior>RelativeToOutput</VLAssetBehavior>
    <VLCleanBuildDirectory>True</VLCleanBuildDirectory>
    <VLIgnoreCompileErrors>False</VLIgnoreCompileErrors>
    <VLIgnoreUnhandledExceptions>False</VLIgnoreUnhandledExceptions>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <VLExportPath>$(MsBuildThisFileDirectory)\artifacts\$(RuntimeIdentifier)</VLExportPath>
    <!-- Uncomment and set path if you have an application icon -->
    <!-- <ApplicationIcon>$(MsBuildThisFileDirectory)\assets\icon.ico</ApplicationIcon> -->
  </PropertyGroup>
  <!-- Uncomment to include assets folder in build output -->
  <!--
  <ItemGroup>
    <ContentWithTargetPath Include="$(MsBuildThisFileDirectory)assets\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>assets\%(RecursiveDir)%(FileName)%(Extension)</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>
  -->
</Project>
